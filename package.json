    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
