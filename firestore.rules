rules_version = '2';

// MonoChrome security rules.
// Everything is denied unless a rule below allows it. New collections (public profiles,
// neighbourhoods, invites) get their own rules when those features are built.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Private data: routine, vows, day history, settings and the passcode hash.
    // Only the signed-in owner can read or write anything under their own user document.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
