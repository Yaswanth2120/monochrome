rules_version = '2';

// MonoChrome security rules.
// Everything is denied unless a rule below allows it. New collections (public profiles,
// neighbourhoods, invites) get their own rules when those features are built.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid}: the account's private profile (display name and passcode hash).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);

      function validProfile(data) {
        return data.keys().hasOnly(["name", "passcode", "updatedAt"])
          && (!("name" in data) || (data.name is string && data.name.size() <= 120))
          && (!("passcode" in data) || validPasscode(data.passcode));
      }
      function validPasscode(p) {
        return p is map
          && p.keys().hasOnly(["salt", "hash", "iterations"])
          && p.salt is string && p.salt.size() == 32
          && p.hash is string && p.hash.size() == 64
          && p.iterations is int && p.iterations >= 100000 && p.iterations <= 1000000;
      }

      // users/{uid}/days/{yyyy-mm-dd}: one document per day of the routine.
      match /days/{day} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && day.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && validDay(request.resource.data);
        allow delete: if isOwner(uid);
      }
      function validDay(d) {
        return d.keys().hasOnly(["done", "counts", "parts", "slipped", "complete", "kept", "total", "updatedAt"])
          && (!("kept" in d) || (d.kept is int && d.kept >= 0 && d.kept <= 100))
          && (!("total" in d) || (d.total is int && d.total >= 0 && d.total <= 100))
          && d.done is list && d.done.size() <= 100
          && d.slipped is list && d.slipped.size() <= 100
          && d.counts is map
          && d.parts is map
          && d.complete is bool;
      }

      // users/{uid}/settings/routine: the user's tasks and vows, plus an edit waiting for tomorrow.
      match /settings/{name} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && name == "routine" && validRoutineDoc(request.resource.data);
        allow delete: if isOwner(uid);
      }
      function validRoutine(r) {
        return r.tasks is list && r.tasks.size() >= 1 && r.tasks.size() <= 24
          && r.vows is list && r.vows.size() <= 6;
      }
      function validRoutineDoc(d) {
        return d.keys().hasOnly(["tasks", "vows", "pending", "updatedAt"])
          && validRoutine(d)
          && (!("pending" in d) || d.pending == null
            || (d.pending is map
              && d.pending.keys().hasOnly(["tasks", "vows", "from"])
              && validRoutine(d.pending)
              && d.pending.from is string
              && d.pending.from.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")));
      }
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
